<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WatchLists.MVVM.Views.EditWatchItemPage"
             Title="Manage Media Item">

    <ScrollView Padding="12,10">
        <StackLayout Spacing="12">

            <!-- Primary API Search Action Header Button -->
            <Button AutomationId="SearchApisButton"
                    Text="🔍 Search Movies &amp; TV Shows (API Aggregator)"
                    Command="{Binding OpenSearchCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="50"
                    FontSize="15"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill" />

            <!-- Movie Poster & Overview Header Card -->
            <Frame Style="{StaticResource ElevatedCardStyle}"
                   Padding="12"
                   IsVisible="{Binding EditableItem.PosterUrl, Converter={StaticResource StringToBoolConverter}}">
                <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            WidthRequest="100"
                            HeightRequest="145"
                            VerticalOptions="Start">
                        <Image Source="{Binding EditableItem.PosterUrl}" Aspect="AspectFill" />
                    </Border>

                    <StackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding MovieTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

                        <Label Text="{Binding EditableItem.Overview}"
                               FontSize="12"
                               MaxLines="5"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Media Identification Form Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="Media Details"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Title" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Entry AutomationId="TitleEntry"
                               Placeholder="Movie or TV Show title..."
                               Text="{Binding MovieTitle}" />
                    </Border>

                    <Label Text="Media Type" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="TypePicker"
                                Title="Select type (Movie, Show, Mini-Series)"
                                ItemsSource="{Binding AvailableTypes}"
                                SelectedItem="{Binding EditableItem.Type, Mode=TwoWay}" />
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Streaming & Classification Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="Category &amp; Platform"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="CategoryPicker"
                                Title="Select category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding EditableItem.Category, Mode=TwoWay}"
                                SelectedIndexChanged="OnCategorySelectionChanged" />
                    </Border>

                    <Label Text="Streaming Service" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="StreamingServicePicker"
                                Title="Select streaming service"
                                ItemsSource="{Binding StreamingServices}"
                                SelectedItem="{Binding SelectedStreamingService, Mode=TwoWay}" />
                    </Border>

                    <!-- Availability Row -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
                        <Label Text="{Binding EditableItem.AvailableStreamingServicesDisplay}"
                               Grid.Column="0"
                               VerticalOptions="Center"
                               FontSize="11"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

                        <Button AutomationId="RefreshStreamingServicesButton"
                                Text="🔄 Refresh Providers"
                                Grid.Column="1"
                                Command="{Binding RefreshStreamingServicesCommand}"
                                VerticalOptions="Center"
                                HeightRequest="36"
                                Padding="10,0"
                                FontSize="11" />
                    </Grid>

                    <Label Text="App / Web Deep Link" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Entry AutomationId="DeepLinkEntry"
                               Placeholder="Direct URI or web playback link..."
                               Text="{Binding MovieDeepLinkUri}" />
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Rating & Watched Status Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="Watch Status &amp; Rating"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Marked as Watched"
                               VerticalOptions="Center"
                               FontSize="14" />
                        <Switch Grid.Column="1"
                                AutomationId="WatchedSwitch"
                                IsToggled="{Binding IsWatched}"
                                Toggled="Switch_Toggled"
                                VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="0,4" />

                    <!-- Rating Buttons -->
                    <Label Text="Personal Rating:" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Center" WidthRequest="220">
                        <Button Grid.Column="0"
                                AutomationId="ThumbsUpButton"
                                Text="👍 Like"
                                Command="{Binding ToggleIsLikedCommand}"
                                CommandParameter="{StaticResource TrueBoolean}"
                                HeightRequest="44"
                                BackgroundColor="{Binding IsLiked, Converter={StaticResource BoolToColorConverter}}" />

                        <Button Grid.Column="1"
                                AutomationId="ThumbsDownButton"
                                Text="👎 Dislike"
                                Command="{Binding ToggleIsLikedCommand}"
                                CommandParameter="{StaticResource FalseBoolean}"
                                HeightRequest="44"
                                BackgroundColor="{Binding IsDisliked, Converter={StaticResource BoolToColorConverter}}" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Aggregated Provider Data Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="🌐 Aggregated Provider Data"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                        <Button Grid.Column="1"
                                Text="{Binding AggregatedDataExpandIcon}"
                                Command="{Binding ToggleAggregatedDataExpandedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HeightRequest="32"
                                Padding="10,0"
                                FontSize="11"
                                VerticalOptions="Center" />
                    </Grid>

                    <Label Text="No additional provider metadata found (tap Refresh Providers above to check)."
                           FontSize="12"
                           FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           IsVisible="{Binding HasNoAggregatedData}" />

                    <CollectionView ItemsSource="{Binding AggregatedDataItems}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsAggregatedDataContentVisible}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="160,*" Padding="0,4">
                                    <Label Grid.Column="0"
                                           Text="{Binding Key}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Value}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Save Action Button -->
            <Button AutomationId="SaveButton"
                    Text="💾 Save Changes"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48"
                    Margin="0,4,0,16"
                    HorizontalOptions="Fill" />
        </StackLayout>
    </ScrollView>
</ContentPage>
