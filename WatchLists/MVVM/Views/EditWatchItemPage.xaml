<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WatchLists.MVVM.Views.EditWatchItemPage">

       <StackLayout Padding="10"
                    Spacing="12">
              <Entry AutomationId="TitleEntry"
                     Placeholder="Title"
                     Text="{Binding MovieTitle}" />
              <Picker AutomationId="StreamingServicePicker"
                      Title="Streaming Service"
                      ItemsSource="{Binding StreamingServices}"
                      SelectedItem="{Binding SelectedStreamingService, Mode=TwoWay}" />
              <Picker AutomationId="CategoryPicker"
                      Title="Category"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding EditableItem.Category, Mode=TwoWay}"
                      SelectedIndexChanged="OnCategorySelectionChanged" />
              <Entry AutomationId="DeepLinkEntry"
                     Placeholder="Deep Link"
                     Text="{Binding MovieDeepLinkUri}" />

              <!-- Type Dropdown -->
              <Picker AutomationId="TypePicker"
                      Title="Type"
                      ItemsSource="{Binding AvailableTypes}"
                      SelectedItem="{Binding EditableItem.Type, Mode=TwoWay}" />

              <!-- IsWatched Checkbox -->
              <StackLayout Orientation="Horizontal">
                     <Label Text="Watched:"
                            VerticalOptions="Center" />
                     <Switch AutomationId="WatchedSwitch"
                             IsToggled="{Binding IsWatched}"
                             Toggled="Switch_Toggled" />
              </StackLayout>

              <!-- Thumbs Up/Down UI -->
              <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                     <Button AutomationId="ThumbsUpButton"
                             Text="👍"
                             Command="{Binding ToggleIsLikedCommand}"
                             CommandParameter="{StaticResource TrueBoolean}"
                             BackgroundColor="{Binding IsLiked, Converter={StaticResource BoolToColorConverter}}" />
                     <Button AutomationId="ThumbsDownButton"
                             Text="👎"
                             Command="{Binding ToggleIsLikedCommand}"
                             CommandParameter="{StaticResource FalseBoolean}"
                             BackgroundColor="{Binding IsDisliked, Converter={StaticResource BoolToColorConverter}}" />
              </StackLayout>

              <Button AutomationId="SearchApisButton"
                      Text="Search APIs"
                      Command="{Binding OpenSearchCommand}"
                      Style="{StaticResource PrimaryButtonStyle}" />

              <Button AutomationId="SaveButton" Text="Save" Command="{Binding SaveCommand}" />
       </StackLayout>
</ContentPage>
