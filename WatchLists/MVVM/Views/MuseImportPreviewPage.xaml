<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WatchLists.MVVM.ViewModels"
             xmlns:models="clr-namespace:WatchLists.MVVM.Models"
             xmlns:import="clr-namespace:WatchLists.Services.MuseImport"
             x:Class="WatchLists.MVVM.Views.MuseImportPreviewPage"
             x:DataType="viewmodels:MuseImportPreviewViewModel"
             Title="Muse import preview">
    <Grid Padding="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Button Grid.Row="0" Text="Choose Muse file" Command="{Binding OpenFileCommand}" />
        <Label Grid.Row="1" Text="{Binding Status}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Recommendations}"
                        SelectionMode="Single" SelectedItem="{Binding SelectedRecommendation}"
                        AutomationId="MuseRecommendations">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="import:MuseRecommendation">
                    <VerticalStackLayout Padding="8" Spacing="2">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ScrollView Grid.Row="3" MaximumHeightRequest="300">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Details}" />
                <Button Text="Resume pending searches" Command="{Binding StartSuggestionsCommand}" />
                <Button Text="Stop pending searches" Command="{Binding StopSuggestionsCommand}" />
                <Button Text="End review" Clicked="EndReview" />
                <Picker Title="Possible existing item" ItemsSource="{Binding ExistingMatches}"
                        ItemDisplayBinding="{Binding ImportReviewDisplay, x:DataType=models:WatchItem}" SelectedItem="{Binding SelectedExisting}" />
                <Button Text="Approve existing item" Command="{Binding ApproveExistingCommand}" />
                <Button Text="Search TMDB movies" Command="{Binding SearchProviderCommand}" />
                <Button Text="Search TVMaze shows" Command="{Binding SearchShowsCommand}" />
                <Picker Title="Provider result" ItemsSource="{Binding ProviderMatches}"
                        ItemDisplayBinding="{Binding Display, x:DataType=import:MuseProviderCandidate}" SelectedItem="{Binding SelectedProvider}" />
                <Picker Title="Category for new items" ItemsSource="{Binding ImportCategories}" SelectedItem="{Binding SelectedCategory}" />
                <Button Text="Approve provider result" Command="{Binding ApproveProviderCommand}" />
                <Button Text="Clear approval for selected row" Command="{Binding ClearApprovalCommand}" />
                <Label Text="Approved rows:" FontAttributes="Bold" />
                <Label Text="{Binding ApprovalSummary}" />
                <Label Text="Turn off automatic sync before import. Older app versions can overwrite recommendation sources." FontAttributes="Italic" />
                <Button Text="Import approved rows" Clicked="ImportApproved" AutomationId="MuseImportButton" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
