<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WatchLists.MVVM.ViewModels"
             xmlns:models="clr-namespace:WatchLists.MVVM.Models"
             xmlns:import="clr-namespace:WatchLists.Services.MuseImport"
             x:Class="WatchLists.MVVM.Views.MuseImportPreviewPage"
             x:DataType="viewmodels:MuseImportPreviewViewModel"
             Title="Muse import preview">
    <Grid Padding="12" RowDefinitions="Auto,Auto,2*,3*" RowSpacing="8">
        <Button Grid.Row="0" Text="Choose Muse file" Command="{Binding OpenFileCommand}" />
        <Label Grid.Row="1" Text="{Binding Status}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Recommendations}"
                        SelectionMode="Single" SelectedItem="{Binding SelectedRecommendation}"
                        AutomationId="MuseRecommendations">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="import:MuseRecommendation">
                    <VerticalStackLayout Padding="8" Spacing="2">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="6">
                <Label Text="1. Select a recommendation above. 2. Choose a matching suggestion below. 3. Approve it, then import your approved rows." FontAttributes="Bold" />
                <Label Text="{Binding Details}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Stop searches" Command="{Binding StopSuggestionsCommand}" />
                    <Button Grid.Column="1" Text="Resume searches" Command="{Binding StartSuggestionsCommand}" />
                </Grid>
                <Label Text="Add a new item" FontAttributes="Bold" />
                <Label Text="Choose the correct title, year and type from the suggested matches." />
                <Picker Title="Choose a suggested match" ItemsSource="{Binding ProviderMatches}"
                        AutomationId="MuseProviderPicker"
                        ItemDisplayBinding="{Binding Display, x:DataType=import:MuseProviderCandidate}" SelectedItem="{Binding SelectedProvider}" />
                <Picker Title="Choose a category for the new item" ItemsSource="{Binding ImportCategories}" SelectedItem="{Binding SelectedCategory}" />
                <Button Text="Approve new item" Command="{Binding ApproveProviderCommand}" AutomationId="MuseApproveNewButton" />
                <Label Text="{Binding ApprovalFeedback}" AutomationId="MuseNewApprovalFeedback" />
                <Label Text="Already in your WatchList?" FontAttributes="Bold" />
                <Label Text="Choose the saved item instead of adding a duplicate." />
                <Picker Title="Choose an existing item" ItemsSource="{Binding ExistingMatches}"
                        AutomationId="MuseExistingPicker"
                        ItemDisplayBinding="{Binding ImportReviewDisplay, x:DataType=models:WatchItem}" SelectedItem="{Binding SelectedExisting}" />
                <Button Text="Approve existing item" Command="{Binding ApproveExistingCommand}" AutomationId="MuseApproveExistingButton" />
                <Label Text="{Binding ApprovalFeedback}" AutomationId="MuseExistingApprovalFeedback" />
                <Label Text="Need a different match?" FontAttributes="Bold" />
                <Button Text="Search TMDB movies" Command="{Binding SearchProviderCommand}" />
                <Button Text="Search TVMaze shows" Command="{Binding SearchShowsCommand}" />
                <Button Text="End review" Clicked="EndReview" />
                <Button Text="Clear approval for selected row" Command="{Binding ClearApprovalCommand}" />
                <Label Text="Approved rows:" FontAttributes="Bold" />
                <Label Text="{Binding ApprovalSummary}" />
                <Label Text="Turn off automatic sync before import. Older app versions can overwrite recommendation sources." FontAttributes="Italic" />
                <Button Text="Import approved rows" Clicked="ImportApproved" AutomationId="MuseImportButton" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
