<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WatchLists.MVVM.Views.MovieDetailsPage"
             Title="{Binding MovieDetail.Title}">

    <ScrollView Padding="16,12">
        <StackLayout Spacing="14" HorizontalOptions="FillAndExpand">

            <!-- Hero Poster Artwork Card -->
            <Frame Style="{StaticResource ElevatedCardStyle}"
                   Padding="12"
                   HorizontalOptions="Center"
                   Margin="0,6">
                <Border WidthRequest="210"
                        HeightRequest="310"
                        HorizontalOptions="Center">
                    <Image Source="{Binding MovieDetail.PosterPath, Converter={StaticResource ImageConverter}}"
                           Aspect="AspectFill" />
                </Border>
            </Frame>

            <!-- Movie Title & Release Banner -->
            <StackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="{Binding MovieDetail.Title}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

                <Label Text="{Binding MovieDetail.ReleaseDate, StringFormat='Released: {0}'}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            </StackLayout>

            <!-- Select Movie Action Button -->
            <Button Text="➕ Select &amp; Add to WatchList"
                    Command="{Binding SelectMovieCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48"
                    Margin="12,6"
                    HorizontalOptions="Fill" />

            <!-- Overview Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="16">
                <StackLayout Spacing="8">
                    <Label Text="Synopsis Overview"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="{Binding MovieDetail.Overview}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                           LineBreakMode="WordWrap" />
                </StackLayout>
            </Frame>

            <!-- Aggregated Provider Data Card -->
            <Frame Style="{StaticResource CardStyle}" Padding="16">
                <StackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="🌐 Aggregated Provider Data"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                        <Button Grid.Column="1"
                                Text="{Binding AggregatedDataExpandIcon}"
                                Command="{Binding ToggleAggregatedDataExpandedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HeightRequest="32"
                                Padding="10,0"
                                FontSize="11"
                                VerticalOptions="Center" />
                    </Grid>

                    <Label Text="No additional provider metadata found."
                           FontSize="12"
                           FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           IsVisible="{Binding HasNoAggregatedData}" />

                    <CollectionView ItemsSource="{Binding AggregatedDataItems}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsAggregatedDataContentVisible}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="160,*" Padding="0,4">
                                    <Label Grid.Column="0"
                                           Text="{Binding Key}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Value}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
