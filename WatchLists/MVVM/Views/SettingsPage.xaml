<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:WatchLists.Converters"
             x:Class="WatchLists.MVVM.Views.SettingsPage"
             Title="Settings">

    <ScrollView Padding="12,10">
        <StackLayout Spacing="14">

            <!-- Section 1: Streaming Services -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="📺 Streaming Services"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Service" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="StreamingServicePicker"
                                Title="Select a Streaming Service"
                                ItemsSource="{Binding StreamingServices}"
                                SelectedItem="{Binding SelectedStreamingService}" />
                    </Border>

                    <Button AutomationId="ManageStreamingServicesButton"
                            Text="Manage Streaming Services"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="StreamingServices"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

            <!-- Section 2: Watchlist Categories -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🏷️ Categories"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="CategoryPicker"
                                Title="Select a Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}" />
                    </Border>

                    <Button AutomationId="ManageCategoriesButton"
                            Text="Manage Categories"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Categories"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <BoxView HeightRequest="1" Margin="0,4" />

                    <Label Text="Designated Watched Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="WatchedCategoryPicker"
                                Title="Select Watched Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedWatchedCategory, Mode=TwoWay}" />
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Section 3: Media Types -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🎬 Media Types"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Type" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="TypePicker"
                                Title="Select a Type"
                                ItemsSource="{Binding Types}"
                                SelectedItem="{Binding SelectedType}" />
                    </Border>

                    <Button AutomationId="ManageTypesButton"
                            Text="Manage Types"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Types"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
