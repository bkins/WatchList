<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:WatchLists.Converters"
             x:Class="WatchLists.MVVM.Views.SettingsPage"
             Title="Settings">

    <ScrollView Padding="12,10">
        <StackLayout Spacing="14">

            <!-- Section 1: Streaming Services -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="📺 Streaming Services"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Service" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="StreamingServicePicker"
                                Title="Select a Streaming Service"
                                ItemsSource="{Binding StreamingServices}"
                                SelectedItem="{Binding SelectedStreamingService}" />
                    </Border>

                    <Button AutomationId="ManageStreamingServicesButton"
                            Text="Manage Streaming Services"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="StreamingServices"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

            <!-- Section 2: Watchlist Categories -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🏷️ Categories"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="CategoryPicker"
                                Title="Select a Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}" />
                    </Border>

                    <Button AutomationId="ManageCategoriesButton"
                            Text="Manage Categories"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Categories"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <BoxView HeightRequest="1" Margin="0,4" />

                    <Label Text="Designated Watched Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="WatchedCategoryPicker"
                                Title="Select Watched Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedWatchedCategory, Mode=TwoWay}" />
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Section 3: Media Types -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🎬 Media Types"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Type" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="TypePicker"
                                Title="Select a Type"
                                ItemsSource="{Binding Types}"
                                SelectedItem="{Binding SelectedType}" />
                    </Border>

                    <Button AutomationId="ManageTypesButton"
                            Text="Manage Types"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Types"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

            <!-- Section 4: Data Synchronization -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🔄 Data Synchronization"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Sync Mode" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="4">
                        <Picker AutomationId="SyncModePicker"
                                ItemsSource="{Binding SyncModes}"
                                SelectedItem="{Binding SyncMode, Mode=TwoWay}"
                                FontSize="12" />
                    </Border>

                    <!-- Cloud API Section -->
                    <StackLayout IsVisible="{Binding IsCloudApiMode}" Spacing="8">
                        <Label Text="Sync Code (Pair Laptop &amp; Phone)" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Border Padding="6">
                            <Entry AutomationId="SyncCodeEntry"
                                   Text="{Binding SyncCode, Mode=TwoWay}"
                                   Placeholder="Enter pairing code e.g. MyWatchList2026"
                                   FontSize="12" />
                        </Border>

                        <Label Text="Cloud Endpoint URL" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <Border Padding="6" Grid.Column="0">
                                <Entry AutomationId="ApiEndpointUrlEntry"
                                       Text="{Binding ApiEndpointUrl, Mode=TwoWay}"
                                       Placeholder="HTTPS REST Endpoint URL or tap Create..."
                                       FontSize="12" />
                            </Border>
                            <Button AutomationId="CreateCloudEndpointButton"
                                    Grid.Column="1"
                                    Text="➕ Create Storage"
                                    Command="{Binding CreateNewCloudEndpointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackLayout>

                    <!-- File System Section -->
                    <StackLayout IsVisible="{Binding IsFileSystemMode}" Spacing="8">
                        <Label Text="Shared Sync Storage Directory" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                            <Border Padding="6" Grid.Column="0">
                                <Entry AutomationId="SyncFolderPathEntry"
                                       Text="{Binding SyncFolderPath, Mode=TwoWay}"
                                       Placeholder="Select or enter folder path..."
                                       FontSize="12" />
                            </Border>
                            <Button AutomationId="BrowseSyncFolderButton"
                                    Grid.Column="1"
                                    Text="📁 Browse"
                                    Command="{Binding PickSyncFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button AutomationId="UseDefaultAppFolderButton"
                                    Grid.Column="2"
                                    Text="📱 App Storage"
                                    Command="{Binding UseDefaultAppFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackLayout>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Auto-Sync Data" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Automatically import on launch and export on changes" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        </StackLayout>
                        <Switch AutomationId="AutoSyncSwitch"
                                Grid.Column="1"
                                IsToggled="{Binding AutoSyncEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Button AutomationId="SyncNowButton"
                            Text="⚡ Sync Now"
                            Command="{Binding SyncNowCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <Label Text="{Binding SyncStatusMessage}"
                           FontSize="12"
                           FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
