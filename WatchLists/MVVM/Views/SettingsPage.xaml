<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WatchLists.MVVM.ViewModels"
             xmlns:models="clr-namespace:WatchLists.MVVM.Models"
             xmlns:backup="clr-namespace:WatchLists.Services.Restoration"
             x:DataType="viewmodels:SettingsViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:WatchLists.Converters"
             x:Class="WatchLists.MVVM.Views.SettingsPage"
             Title="Settings">

    <ScrollView Padding="12,10">
        <StackLayout Spacing="14">

            <!-- Section 1: Streaming Services -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="📺 Streaming Services"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Service" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="StreamingServicePicker"
                                Title="Select a Streaming Service"
                                ItemsSource="{Binding StreamingServices}"
                                SelectedItem="{Binding SelectedStreamingService}" />
                    </Border>

                    <Button AutomationId="ManageStreamingServicesButton"
                            Text="Manage Streaming Services"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="StreamingServices"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

            <!-- Section 2: Watchlist Categories -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🏷️ Categories"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="CategoryPicker"
                                Title="Select a Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}" />
                    </Border>

                    <Button AutomationId="ManageCategoriesButton"
                            Text="Manage Categories"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Categories"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <BoxView HeightRequest="1" Margin="0,4" />

                    <Label Text="Designated Watched Category" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="WatchedCategoryPicker"
                                Title="Select Watched Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedWatchedCategory, Mode=TwoWay}" />
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Section 3: Media Types -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🎬 Media Types"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Select Active Type" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Border Padding="2">
                        <Picker AutomationId="TypePicker"
                                Title="Select a Type"
                                ItemsSource="{Binding Types}"
                                SelectedItem="{Binding SelectedType}" />
                    </Border>

                    <Button AutomationId="ManageTypesButton"
                            Text="Manage Types"
                            Command="{Binding NavigateToManageOptionsCommand}"
                            CommandParameter="Types"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Restore a WatchList backup" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Turn off automatic sync before restoring. A rollback backup is created first." FontSize="12" />
                    <VerticalStackLayout Spacing="8" IsEnabled="{Binding CanEditSync}">
                        <Picker AutomationId="RestoreBackupPicker" Title="Select a local backup"
                                ItemsSource="{Binding RestoreBackups}" SelectedItem="{Binding SelectedRestoreBackup}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=backup:WatchListBackupFile}" />
                        <Button AutomationId="ReviewLocalRestoreBackupButton" Text="Review selected backup"
                                Command="{Binding ReviewLocalRestoreBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button AutomationId="PickRestoreBackupButton" Text="Choose backup file…"
                                Command="{Binding PickRestoreBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </VerticalStackLayout>
                    <Label AutomationId="RestoreBackupStatus" Text="{Binding RestoreStatus}" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Data Synchronization -->
            <Frame Style="{StaticResource CardStyle}" Padding="14">
                <StackLayout Spacing="10">
                    <Label Text="🔄 Data Synchronization"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                    <Label Text="Pair upgraded devices with a private Firebase Realtime Database. Shared-folder sync is paused."
                           FontSize="12" />
                    <VerticalStackLayout Spacing="8" IsEnabled="{Binding CanEditSync}">
                        <Entry AutomationId="ApiEndpointUrlEntry" Text="{Binding ApiEndpointUrl}"
                               Placeholder="Firebase database root URL" Keyboard="Url" />
                        <Entry AutomationId="FirebaseApiKeyEntry" Text="{Binding FirebaseApiKey}"
                               Placeholder="Firebase web API key" />
                        <Entry AutomationId="FirebaseEmailEntry" Text="{Binding FirebaseEmail}"
                               Placeholder="Firebase account email" Keyboard="Email" />
                        <Entry AutomationId="FirebasePasswordEntry" Text="{Binding FirebasePassword}"
                               Placeholder="Firebase account password" IsPassword="True" />
                        <Entry AutomationId="SyncCodeEntry" Text="{Binding SyncCode}"
                               Placeholder="Pairing code, or leave blank for a new pairing" />
                        <Button AutomationId="PairFirebaseButton" Text="Sign in and save pairing"
                                Command="{Binding PairFirebaseCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button AutomationId="CreateCloudEndpointButton" Text="Create Storage"
                                Command="{Binding CreateNewCloudEndpointCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button AutomationId="SyncNowButton" Text="Sync Now"
                                Command="{Binding SyncNowCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button AutomationId="BackupSyncDataButton" Text="Back Up Local Sync Data"
                                Command="{Binding BackupSyncDataCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Auto-Sync Data" VerticalOptions="Center" />
                            <Switch Grid.Column="1" AutomationId="AutoSyncSwitch" IsToggled="{Binding AutoSyncEnabled}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button AutomationId="CancelSyncButton" Text="Cancel Sync" IsVisible="{Binding IsSyncBusy}"
                            Command="{Binding CancelSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <VerticalStackLayout IsVisible="{Binding HasConflict}" IsEnabled="{Binding CanEditSync}" Spacing="8">
                        <Label Text="Review both versions" FontAttributes="Bold" />
                        <Label Text="The choice applies to the affected entries. Any newer edit requires another review." />
                        <Label Text="On this device" FontAttributes="Bold" />
                        <Label AutomationId="LocalSyncConflict" Text="{Binding LocalConflictDetails}" />
                        <Label Text="In Firebase" FontAttributes="Bold" />
                        <Label AutomationId="CloudSyncConflict" Text="{Binding CloudConflictDetails}" />
                        <Button AutomationId="KeepLocalSyncButton" Text="Use this device’s copy for conflicts"
                                Command="{Binding KeepLocalCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button AutomationId="KeepCloudSyncButton" Text="Use Firebase’s copy for conflicts"
                                Command="{Binding KeepCloudCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding SyncStatusMessage}"
                           FontSize="12"
                           FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
