<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:import="clr-namespace:WatchLists.Services.MuseImport"
             x:Class="WatchLists.MVVM.Views.MuseRecommendationDetailsPage"
             x:DataType="import:MuseRecommendation"
             Title="Recommendation Details">
    <Grid Padding="16" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollView>
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold" />
                <Label Text="{Binding Section, StringFormat='Section: {0}'}" />
                <Label Text="{Binding LineNumber, StringFormat='Muse line: {0}'}" />
                <Label Text="{Binding ReleaseYear, StringFormat='Year: {0}'}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ReleaseYear}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="Muse description" FontAttributes="Bold" />
                <Editor Text="{Binding Description}"
                        IsReadOnly="True"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="72"
                        AutomationId="MuseRecommendationDescription" />
                <Label Text="Muse source links" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SourceUrls}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding .}"
                                       TextColor="{StaticResource Primary}"
                                       TextDecorations="Underline"
                                       AutomationId="MuseRecommendationClickableSource">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OpenSource" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding .}"
                                           IsReadOnly="True"
                                           MinimumHeightRequest="48"
                                           AutomationId="MuseRecommendationSelectableSource" />
                                    <Button Grid.Column="1"
                                            Text="Copy"
                                            Clicked="CopySource"
                                            MinimumHeightRequest="48" />
                                    <Button Grid.Column="2"
                                            Text="Open"
                                            Clicked="OpenSourceButton"
                                            MinimumHeightRequest="48" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="SavedAssociationsSection" Spacing="4" IsVisible="False">
                    <Label Text="Saved source associations" FontAttributes="Bold" />
                    <Label x:Name="SavedAssociationsText" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1"
                Text="Close"
                Clicked="CloseDetails"
                MinimumHeightRequest="48" />
    </Grid>
</ContentPage>
