<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:WatchLists.MVVM.ViewModels"
    xmlns:models="clr-namespace:WatchLists.MVVM.Models"
    xmlns:views="clr-namespace:WatchLists.MVVM.Views"
    x:DataType="viewmodels:WatchListViewModel"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="WatchLists.MVVM.Views.MainPage"
    x:Name="PageReference"
    Title="WatchList">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh"
                     AutomationId="RefreshToolbarItem"
                     Command="{Binding ViewModel.RefreshItemsCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{StaticResource RefreshIcon}"
                                 FontFamily="MaterialIcons"
                                 Size="22"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,8">

        <!-- Header Stat Cards & App Header -->
        <Frame Grid.Row="0"
               Style="{StaticResource ElevatedCardStyle}"
               Padding="14,12"
               Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <!-- App Banner Header -->
                <VerticalStackLayout Grid.Row="0" Spacing="8">
                    <StackLayout Grid.Column="0" Spacing="2">
                        <Label Text="My WatchList"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label Text="Movies and shows saved for later"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </StackLayout>
                    <FlexLayout Wrap="Wrap" Direction="Row">
                        <Button Text="Select"
                                Margin="0,0,8,0"
                                AutomationId="ToggleSelectModeButton"
                                Command="{Binding ToggleSelectionModeCommand}"
                                MinimumHeightRequest="48"
                                Padding="12,4"
                                FontSize="12"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                        <Button Text="Add media"
                                Command="{Binding AddItemCommand}"
                                MinimumHeightRequest="48"
                                Padding="12,4"
                                FontSize="12"
                                CornerRadius="8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Multi-Select Action Bar -->
                <FlexLayout Grid.Row="1" Wrap="Wrap" Direction="Row" AlignItems="Center"
                      IsVisible="{Binding IsSelectionMode}"
                      Padding="4,2">
                    <Label Margin="0,0,8,4"
                           Text="{Binding SelectedItemsCount, StringFormat='{0} selected'}"
                           VerticalOptions="Center"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                    <Button Margin="0,0,8,4"
                            Text="Select All"
                            AutomationId="SelectAllButton"
                            Command="{Binding SelectAllCommand}"
                            MinimumHeightRequest="48"
                            Padding="10,2"
                            FontSize="11"
                            CornerRadius="6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <Button Margin="0,0,8,4"
                            Text="Clear"
                            AutomationId="ClearSelectionButton"
                            Command="{Binding ClearSelectionCommand}"
                            MinimumHeightRequest="48"
                            Padding="10,2"
                            FontSize="11"
                            CornerRadius="6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <Button Margin="0,0,8,4"
                            Text="Delete"
                            AutomationId="DeleteSelectedButton"
                            Command="{Binding DeleteSelectedItemsCommand}"
                            MinimumHeightRequest="48"
                            Padding="10,2"
                            FontSize="11"
                            CornerRadius="6"
                            BackgroundColor="{StaticResource Tertiary}"
                            TextColor="White" />
                </FlexLayout>

                <!-- Dynamic Category Stat Cards Horizontal Bar -->
                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding CategoryStats}"
                                HeightRequest="54"
                                VerticalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:CategoryStatCardItem">
                            <Button Text="{Binding DisplayText}"
                                    Command="{Binding SelectCommand}"
                                    MinimumHeightRequest="48"
                                    Padding="12,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    SemanticProperties.Hint="Expand this category in your WatchList">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                        <Setter Property="BorderWidth" Value="2" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Frame>

        <!-- SearchBar for Filtering -->
        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
            <SearchBar AutomationId="WatchListSearchBar"
                       Placeholder="Search titles..."
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Margin="0" />
        </Border>

        <!-- CollectionView Bound to Category Groups -->
        <CollectionView Grid.Row="2"
                        AutomationId="WatchItemCollectionView"
                        ItemsSource="{Binding FilteredWatchItemGroups}"
                        VerticalOptions="FillAndExpand">
            <CollectionView.EmptyView>
                <Label Text="No titles here yet. Add media or change your search."
                       Padding="16" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WatchItemGroup">
                    <toolkit:Expander IsExpanded="{Binding IsExpanded}">
                        <toolkit:Expander.Header>
                            <!-- Category Header Card -->
                            <Frame Style="{StaticResource CardStyle}"
                                   Padding="12,10"
                                   Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{StaticResource VideoLibraryIcon}"
                                           FontFamily="MaterialIcons"
                                           FontSize="22"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding CategoryName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                           VerticalOptions="Center" />

                                    <!-- Category Count Badge -->
                                    <Border Grid.Column="2"
                                            Padding="8,2"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}">
                                        <Label Text="{Binding ItemCount}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                                    </Border>

                                    <!-- Expand / Collapse Indicator -->
                                    <Label Grid.Column="3"
                                           FontFamily="MaterialIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                           Text="{StaticResource ExpandLessIcon}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}"
                                                         Value="True">
                                                <Setter Property="Text" Value="{StaticResource ExpandMoreIcon}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}"
                                                         Value="False">
                                                <Setter Property="Text" Value="{StaticResource ExpandLessIcon}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Frame>
                        </toolkit:Expander.Header>
                        <toolkit:Expander.Content>
                            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WatchItem">
                                        <SwipeView Margin="4,2">
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItem Command="{Binding ViewModel.EditItemCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                               CommandParameter="{Binding}"
                                                               Text="Edit">
                                                        <SwipeItem.IconImageSource>
                                                            <FontImageSource Glyph="{StaticResource EditIcon}"
                                                                             FontFamily="MaterialIcons"
                                                                             Size="20"
                                                                             Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                                                        </SwipeItem.IconImageSource>
                                                    </SwipeItem>
                                                    <SwipeItem Command="{Binding ViewModel.DeleteItemCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                               CommandParameter="{Binding}"
                                                               Text="Delete">
                                                        <SwipeItem.IconImageSource>
                                                            <FontImageSource Glyph="{StaticResource DeleteIcon}"
                                                                             FontFamily="MaterialIcons"
                                                                             Size="20"
                                                                             Color="{StaticResource Tertiary}" />
                                                        </SwipeItem.IconImageSource>
                                                    </SwipeItem>
                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- Watch Item Card Container -->
                                            <Frame Style="{StaticResource CardStyle}"
                                                   Padding="10"
                                                   Margin="2,4">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <FlyoutBase.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Edit"
                                                                            Command="{Binding ViewModel.EditItemCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                                            CommandParameter="{Binding}" />
                                                            <MenuFlyoutItem Text="Delete"
                                                                            Command="{Binding ViewModel.DeleteItemCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                                            CommandParameter="{Binding}" />
                                                        </MenuFlyout>
                                                    </FlyoutBase.ContextFlyout>

                                                    <!-- Selection CheckBox (visible in selection mode) -->
                                                    <CheckBox SemanticProperties.Description="{Binding Title, StringFormat='Select {0}'}" Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsVisible="{Binding ViewModel.IsSelectionMode, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                              VerticalOptions="Center"
                                                              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                                                    <!-- Poster Image -->
                                                    <Border Grid.Column="1"
                                                            WidthRequest="55"
                                                            HeightRequest="82"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding PosterUrl, Converter={StaticResource StringToBoolConverter}}">
                                                        <Image Source="{Binding PosterUrl}" Aspect="AspectFill" />
                                                    </Border>

                                                    <!-- Media Details & Deep Link Tap Area -->
                                                    <StackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ViewModel.OpenDeepLinkCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                                                  CommandParameter="{Binding}" />
                                                        </StackLayout.GestureRecognizers>

                                                        <Label Text="{Binding Title}"
                                                               FontAttributes="Bold"
                                                               FontSize="15"
                                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

                                                        <StackLayout Orientation="Horizontal" Spacing="6">
                                                            <Border Padding="6,2"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}">
                                                                <Label Text="{Binding StreamingService}"
                                                                       FontSize="11"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
                                                            </Border>

                                                            <Border Padding="6,2"
                                                                    IsVisible="{Binding Type, Converter={StaticResource StringToBoolConverter}}"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceElevated}, Dark={StaticResource DarkSurfaceElevated}}">
                                                                <Label Text="{Binding Type}"
                                                                       FontSize="11"
                                                                       TextColor="{StaticResource Secondary}" />
                                                            </Border>
                                                        </StackLayout>

                                                        <Label Text="{Binding AvailableStreamingServicesDisplay}"
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                               FontAttributes="Italic"
                                                               IsVisible="{Binding HasAvailableStreamingServices}" />
                                                    </StackLayout>

                                                    <!-- Quick Edit Button -->
                                                    <ImageButton SemanticProperties.Description="{Binding Title, StringFormat='Edit {0}'}" Grid.Column="3"
                                                                 MinimumWidthRequest="48"
                                                                 MinimumHeightRequest="48"
                                                                 Padding="4"
                                                                 BackgroundColor="Transparent"
                                                                 Command="{Binding ViewModel.EditItemCommand, Source={x:Reference PageReference}, x:DataType={x:Type views:MainPage}}"
                                                                 CommandParameter="{Binding}"
                                                                 VerticalOptions="Center">
                                                        <ImageButton.Source>
                                                            <FontImageSource Glyph="{StaticResource EditIcon}"
                                                                             FontFamily="MaterialIcons"
                                                                             Size="20"
                                                                             Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                                        </ImageButton.Source>
                                                    </ImageButton>

                                                    <!-- Liked Status Heart Icon -->
                                                    <Image Grid.Column="4"
                                                           WidthRequest="24"
                                                           HeightRequest="24"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="End">
                                                        <Image.Source>
                                                            <FileImageSource File="heart_outline.png" />
                                                        </Image.Source>
                                                        <Image.Triggers>
                                                            <DataTrigger TargetType="Image" Binding="{Binding IsLiked}" Value="True">
                                                                <Setter Property="Source" Value="heart_filled.png" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Image" Binding="{Binding IsLiked}" Value="False">
                                                                <Setter Property="Source" Value="heart_outline.png" />
                                                            </DataTrigger>
                                                        </Image.Triggers>
                                                    </Image>
                                                </Grid>
                                            </Frame>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
