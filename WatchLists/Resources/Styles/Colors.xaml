<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Dark Theme Palette -->
    <Color x:Key="DarkBackground">#0F0F17</Color>
    <Color x:Key="DarkSurface">#181824</Color>
    <Color x:Key="DarkSurfaceElevated">#222234</Color>
    <Color x:Key="DarkBorder">#2E2E44</Color>
    <Color x:Key="DarkTextPrimary">#F3F4F6</Color>
    <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

    <!-- Light Theme Fallback Palette -->
    <Color x:Key="LightBackground">#F8FAFC</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceElevated">#F1F5F9</Color>
    <Color x:Key="LightBorder">#E2E8F0</Color>
    <Color x:Key="LightTextPrimary">#0F172A</Color>
    <Color x:Key="LightTextSecondary">#64748B</Color>

    <!-- Brand & Accent Colors -->
    <Color x:Key="Primary">#7C3AED</Color>
    <Color x:Key="PrimaryDark">#6D28D9</Color>
    <Color x:Key="PrimaryLight">#A78BFA</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    
    <Color x:Key="Secondary">#06B6D4</Color>
    <Color x:Key="SecondaryDarkText">#06B6D4</Color>
    <Color x:Key="Tertiary">#F43F5E</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>

    <!-- Legacy Keys Compatible with Existing Bindings -->
    <Color x:Key="PrimaryColor">#7C3AED</Color>
    <Color x:Key="PrimaryVariantColor">#6D28D9</Color>
    <Color x:Key="SecondaryColor">#06B6D4</Color>
    <Color x:Key="BackgroundColor">#0F0F17</Color>
    <Color x:Key="CardBackgroundColor">#181824</Color>
    <Color x:Key="TextColor">#F3F4F6</Color>
    <Color x:Key="MutedTextColor">#9CA3AF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F0F17</Color>
    <Color x:Key="OffBlack">#181824</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#090D16</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
