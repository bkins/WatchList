<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WatchLists.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WatchLists"
    xmlns:views="clr-namespace:WatchLists.MVVM.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="WatchList">

    <TabBar>
        <Tab Title="WatchList">
            <Tab.Icon>
                <FontImageSource Glyph="{StaticResource VideoLibraryIcon}" FontFamily="MaterialIcons" Size="20" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Discover">
            <Tab.Icon>
                <FontImageSource Glyph="{StaticResource SearchIcon}" FontFamily="MaterialIcons" Size="20" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:SearchPage}" Route="SearchPage" />
        </Tab>

        <Tab Title="Settings">
            <Tab.Icon>
                <FontImageSource Glyph="{StaticResource SettingsIcon}" FontFamily="MaterialIcons" Size="20" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>

        <Tab Title="Dev Tools">
            <Tab.Icon>
                <FontImageSource Glyph="{StaticResource ListIcon}" FontFamily="MaterialIcons" Size="20" />
            </Tab.Icon>
            <ShellContent Title="System Logs" ContentTemplate="{DataTemplate views:LogsPage}" Route="LogsPage" />
            <ShellContent Title="API Test" ContentTemplate="{DataTemplate views:ApiTestPage}" Route="ApiTestPage" />
        </Tab>
    </TabBar>
</Shell>
